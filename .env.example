PW_PUBLIC_BASE_URL=http://127.0.0.1:8000

PW_AGENT_ENABLED=true
PW_AGENT_POLL_SECONDS=20
PW_LLM_PROVIDER=mock

# Gmail SMTP (App Password required)
PW_EMAIL_PROVIDER=smtp
PW_SMTP_HOST=smtp.gmail.com
PW_SMTP_PORT=587
PW_SMTP_USE_TLS=true
PW_SMTP_USERNAME=your.email@gmail.com
PW_SMTP_PASSWORD=your-16-char-app-password
PW_MARKETING_FROM_NAME=WatcherMart Rewards
PW_MARKETING_FROM_EMAIL=your.email@gmail.com

PW_SESSION_SECRET=local-dev-session-secret
PW_MANAGER_USERNAME=manager
PW_MANAGER_PASSWORD=manager
