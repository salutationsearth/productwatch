# Copy to .env and edit.

PW_PUBLIC_BASE_URL=https://productwatch.jacob-yu.com

PW_MCP_TRANSPORT=streamable-http
PW_MCP_HOST=127.0.0.1
PW_MCP_PORT=8001
PW_MCP_PATH=/mcp
PW_MCP_STATELESS_HTTP=true
PW_MCP_PUBLIC_URL=https://mcp.productwatch.jacob-yu.com/mcp
PW_MCP_ALLOWED_HOSTS=mcp.productwatch.jacob-yu.com,localhost,127.0.0.1
PW_MCP_ALLOWED_ORIGINS=https://mcp.productwatch.jacob-yu.com,https://productwatch.jacob-yu.com
PW_MCP_AUTH_TOKEN=change-me-to-a-long-random-secret

PW_EMAIL_PROVIDER=outbox
PW_RESEND_API_KEY=
PW_MARKETING_FROM_NAME=WatcherMart Rewards
PW_MARKETING_FROM_EMAIL=rewards@watchermart.local

PW_SESSION_SECRET=change-me-watchermart-session-secret
PW_MANAGER_USERNAME=manager
PW_MANAGER_PASSWORD=manager

PW_AISLE_API_KEY=change-me-aisle-client-key
# PW_AISLE_SERVER=https://productwatch.jacob-yu.com
