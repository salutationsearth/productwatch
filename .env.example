# Copy to .env and edit. (.env is gitignored.)

PW_PUBLIC_BASE_URL=http://127.0.0.1:8000

PW_LLM_PROVIDER=mock
PW_OPENAI_API_KEY=
PW_OPENAI_MODEL=gpt-4o-mini

PW_EMAIL_PROVIDER=outbox
PW_RESEND_API_KEY=
PW_MARKETING_FROM_NAME=WatcherMart Rewards
PW_MARKETING_FROM_EMAIL=rewards@watchermart.local

PW_SMTP_HOST=
PW_SMTP_PORT=587
PW_SMTP_USERNAME=
PW_SMTP_PASSWORD=
PW_SMTP_USE_TLS=true

PW_AGENT_ENABLED=true
PW_AGENT_POLL_SECONDS=20
PW_AGENT_MIN_INTEREST_WEIGHT=15
PW_AGENT_MIN_HOURS_SINCE_INTEREST=0.02
PW_AGENT_MAX_HOURS_SINCE_INTEREST=72
PW_AGENT_COOLDOWN_HOURS_PER_USER=0.05
PW_AGENT_COOLDOWN_HOURS_PER_PRODUCT=12

PW_GAZE_X_SIGN=1
PW_GAZE_Y_SIGN=1
PW_AISLE_FULLSCREEN=true
