[Unit]
Description=WatcherMart marketing MCP (streamable-http)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/productwatch
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/productwatch/.env
# PW_MCP_TRANSPORT=streamable-http must be set in .env
ExecStart=/opt/productwatch/.venv/bin/python -m backend.mcp.server
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
