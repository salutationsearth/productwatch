[Unit]
Description=WatcherMart web (FastAPI / uvicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/productwatch
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/productwatch/.env
ExecStart=/opt/productwatch/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --app-dir /opt/productwatch
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
